{
  "name": "ttfolio",
  "private": true,
  "version": "0.4.11",
  "description": "ttFolio — a local project workbench to register, browse and manage the code projects on your disk",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "npm run build --workspace @ttfolio/shared && npm run build --workspace @ttfolio/server && npm run build --workspace @ttfolio/web",
    "start": "tsx packages/server/src/index.ts",
    "typecheck": "tsc -p packages/shared/tsconfig.json --noEmit && tsc -p packages/server/tsconfig.json --noEmit && tsc -p packages/web/tsconfig.json --noEmit",
    "lint": "eslint packages/shared/src packages/server/src packages/web/src --max-warnings 0 && npm run format:check",
    "test": "vitest run",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"electron/**/*.cjs\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\" \"scripts/**/*.mjs\" \"electron/**/*.cjs\"",
    "pretest:e2e": "npm run build",
    "test:e2e": "playwright test",
    "migrate": "node scripts/migrate.mjs",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "doctor": "node scripts/doctor.mjs",
    "verify": "node scripts/verify.mjs",
    "build:server": "node scripts/build-server.mjs",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.3.3",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.72.0",
    "vite": "^6.4.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "electron@44.9.3": true,
    "better-sqlite3@12.11.1": true,
    "node-pty@1.1.0": true,
    "esbuild@0.28.2": true,
    "esbuild@0.25.12": true,
    "electron-winstaller@5.4.0": true
  },
  "main": "electron/main.cjs",
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "bindings": "^1.5.0",
    "docx-preview": "^0.4.1",
    "file-uri-to-path": "^2.0.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "author": "TT-Tao178",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TT-Tao178/ttfolio.git"
  },
  "bugs": {
    "url": "https://github.com/TT-Tao178/ttfolio/issues"
  },
  "homepage": "https://github.com/TT-Tao178/ttfolio#readme",
  "keywords": [
    "local-first",
    "project-management",
    "workbench",
    "electron",
    "windows",
    "code-browser",
    "git"
  ]
}
